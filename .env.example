# Shared configuration for the o-isochrone library, FastAPI app, and demo.

# Directory for OSM extracts, extent file, and OSMnx cache.
# Docker Compose sets this to /data and mounts ./data there.
DATA_DIR=./data

# How to load a portion of the road network:
#   pbf      - clip OSM_PBF_PATH with osmium, then build the graph with OSMnx
#   overpass - download the portion from Overpass via OSMnx (fallback if PBF is missing)
OSM_SOURCE=pbf

# Geofabrik Italy extract used by scripts/download_italy.py
OSM_PBF_URL=https://download.geofabrik.de/europe/italy-latest.osm.pbf
OSM_PBF_PATH=./data/italy-roads.osm.pbf
OSM_EXTENT_PATH=./data/extent.geojson

# Fallback / default extent (west,south,east,north) when no extract is present.
# Approximate bounding box of Italy.
OSM_BBOX=6.627,35.493,18.521,47.092

# OSMnx / Overpass
OVERPASS_URL=https://overpass-api.de/api
OSMNX_CACHE_FOLDER=./data/cache
OSMNX_USE_CACHE=true
OSMNX_TIMEOUT=180

# Warm + SQLite tile cache for clipped mode-filtered road graphs (see docs/performance.md).
# Nearby / repeat isochrone requests reuse quantized bbox tiles; startup can preload them.
GRAPH_CACHE_ENABLED=true
GRAPH_CACHE_DIR=./data/graph_cache
GRAPH_SQLITE_PATH=./data/graph_cache/graph_tiles.sqlite
GRAPH_CACHE_MEMORY_SIZE=8
GRAPH_CACHE_GRID_DEG=0.05
# true | tiles (default) — warm existing SQLite tiles into RAM at API startup
# false — skip startup preload (tiles still written/read on demand)
GRAPH_PRELOAD=tiles

# Seed SQLite tiles from coordinate_seed.json (Italy province capitals in the demo).
# Runs in a background thread when the API starts; DB lives under GRAPH_CACHE_DIR (gitignored).
GRAPH_SEED_ON_STARTUP=true
# Optional override; default is the bundled src/oisochrone/data/coordinate_seed.json
# GRAPH_SEED_COORDINATES_PATH=./data/coordinate_seed.json
GRAPH_SEED_MODES=foot,bicycle,car
GRAPH_SEED_TRAVEL_TIMES_MIN=15,30
# Car is capped separately (30+ car clips are very large / OOM-prone).
GRAPH_SEED_CAR_MAX_TRAVEL_TIME_MIN=15

# Average speeds used for travel-time isochrones (km/h)
SPEED_FOOT_KPH=5
SPEED_BICYCLE_KPH=15
SPEED_CAR_KPH=40

# Extra radius when downloading the network so the isochrone is not clipped
DOWNLOAD_MARGIN=1.2
MAX_TRAVEL_TIME_MIN=120

# Demo map search (MapLibre geocoding plugins).
#   photon     - maplibre-gl-geocoder + Komoot Photon (default; free, no API key)
#   nominatim  - maplibre-gl-geocoder + OSM Nominatim (free, no API key; not for heavy autocomplete)
#   stadia     - maplibre-search-box (Stadia Maps; GEOCODER_API_KEY optional on localhost)
#   maptiler   - maptiler-geocoding-control (requires GEOCODER_API_KEY)
GEOCODER_PLUGIN=photon
GEOCODER_API_KEY=
